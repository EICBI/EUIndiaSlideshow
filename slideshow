<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>EU-India Potential Slideshow</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    :root {
      --bg-light: #ffffff;
      --text-light: #333333;
      --bg-dark: #1e1e1e;
      --text-dark: #f0f0f0;
      --primary: #0057b7;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', sans-serif;
      background-color: var(--bg-light);
      color: var(--text-light);
      transition: background-color 0.3s, color 0.3s;
    }

    @media (prefers-color-scheme: dark) {
      body {
        background-color: var(--bg-dark);
        color: var(--text-dark);
      }

      .slide {
        background-color: #2c2c2c;
        color: var(--text-dark);
      }

      .dot {
        background-color: #555;
      }

      .active {
        background-color: #ffd700;
      }
    }

    .slideshow-container {
      max-width: 90%;
      margin: 40px auto;
      position: relative;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    }

    .slide {
      display: none;
      padding: 40px 20px;
      text-align: center;
      background-color: #fff;
      transition: background-color 0.3s;
    }

    .slide h2 {
      font-size: 26px;
      margin-bottom: 15px;
      color: var(--primary);
    }

    .slide p {
      font-size: 18px;
      margin-top: 10px;
    }

    .flag {
      font-size: 28px;
      margin-right: 10px;
      vertical-align: middle;
    }

    .dots {
      text-align: center;
      margin-top: 10px;
    }

    .dot {
      height: 12px;
      width: 12px;
      margin: 0 4px;
      background-color: #bbb;
      border-radius: 50%;
      display: inline-block;
      transition: background-color 0.3s;
    }

    .active {
      background-color: #0057b7;
    }

    @media (max-width: 600px) {
      .slide h2 {
        font-size: 22px;
      }
      .slide p {
        font-size: 16px;
      }
    }
  </style>
</head>
<body>

<!-- Background Music -->
<audio autoplay loop>
  <source src="https://www.bensound.com/bensound-music/bensound-goinghigher.mp3" type="audio/mpeg">
  Your browser does not support the audio element.
</audio>

<div class="slideshow-container">
  <div class="slide fade">
    <h2><span class="flag">🇮🇳</span>Strategic Partnerships<span class="flag">🇪🇺</span></h2>
    <p>EU and India collaborate on defense, diplomacy, and global governance.</p>
  </div>

  <div class="slide fade">
    <h2><span class="flag">🇮🇳</span>Trade & Investment<span class="flag">🇪🇺</span></h2>
    <p>Bilateral trade exceeds €120 billion annually with growing FDI flows.</p>
  </div>

  <div class="slide fade">
    <h2><span class="flag">🇮🇳</span>Innovation & Technology<span class="flag">🇪🇺</span></h2>
    <p>Joint focus on digital infrastructure, AI, and 5G development.</p>
  </div>

  <div class="slide fade">
    <h2><span class="flag">🇮🇳</span>Climate & Sustainability<span class="flag">🇪🇺</span></h2>
    <p>Cooperation on clean energy, green finance, and climate change goals.</p>
  </div>

  <div class="slide fade">
    <h2><span class="flag">🇮🇳</span>Education & Research<span class="flag">🇪🇺</span></h2>
    <p>Thousands of Indian students in EU; joint academic and R&D projects.</p>
  </div>

  <div class="slide fade">
    <h2><span class="flag">🇮🇳</span>Healthcare & Biotech<span class="flag">🇪🇺</span></h2>
    <p>EU-India synergy in pharma, vaccines, and biotech innovations.</p>
  </div>

  <div class="slide fade">
    <h2><span class="flag">🇮🇳</span>Mobility & Talent<span class="flag">🇪🇺</span></h2>
    <p>Focus on migration pathways and skilled professional exchange.</p>
  </div>

  <div class="slide fade">
    <h2><span class="flag">🇮🇳</span>Digital Economy<span class="flag">🇪🇺</span></h2>
    <p>EU-India dialogue on data governance, cybersecurity, and e-commerce.</p>
  </div>
</div>

<div class="dots">
  <span class="dot"></span>
  <span class="dot"></span>
  <span class="dot"></span>
  <span class="dot"></span>
  <span class="dot"></span>
  <span class="dot"></span>
  <span class="dot"></span>
  <span class="dot"></span>
</div>

<script>
  let slideIndex = 0;
  showSlides();

  function showSlides() {
    const slides = document.getElementsByClassName("slide");
    const dots = document.getElementsByClassName("dot");

    for (let i = 0; i < slides.length; i++) {
      slides[i].style.display = "none";  
    }

    slideIndex++;
    if (slideIndex > slides.length) { slideIndex = 1; }

    for (let i = 0; i < dots.length; i++) {
      dots[i].classList.remove("active");
    }

    slides[slideIndex - 1].style.display = "block";  
    dots[slideIndex - 1].classList.add("active");
    setTimeout(showSlides, 4000); // 4 seconds
  }
</script>

</body>
</html>
